# Configuracao do pipeline de notas fiscais e pedidos (Squad 7 Pecados)
#
#  1. copie este arquivo para .env na raiz do projeto:  cp .env.example .env
#  2. preencha os campos vazios (os de token/segredo ficam em branco aqui de proposito);
#  3. valide antes de rodar:  .venv/Scripts/python.exe -m app.run --check-config
#
#  O .env NAO vai para o git (esta no .gitignore). Nunca cole um segredo aqui.
#  Sem .env nenhum o app roda em modo mock com os dados sinteticos - isso nao e erro.
#  Este arquivo e gerado do catalogo de app/config.py; nao edite a mao:
#  regenere com  python tools/gerar_env_example.py

# MODO_EXECUCAO  [obrigatoria em: sempre]
#   Como o pipeline roda: 'mock' (dados sinteticos, padrao) ou 'real' (coleta dos canais).
#   Onde obter: Digitado pelo operador. As flags --mock/--real da linha de comando sobrepoem este valor.
#   Padrao: mock
MODO_EXECUCAO=mock

# CANAIS_ATIVOS  [obrigatoria em: real]
#   Canais coletados no modo real, separados por virgula (aceitos: whatsapp, telegram).
#   Onde obter: Digitado pelo operador, conforme os canais que ele conectou.
#   Padrao: whatsapp,telegram
CANAIS_ATIVOS=whatsapp,telegram

# INBOX_DIR
#   Diretorio de entrada com as subpastas pdf/, whatsapp/ e telegram/ (padrao: data/mocks no modo mock, data/inbox no modo real).
#   Onde obter: Caminho no servidor. Deixe vazio para usar o padrao do modo escolhido.
#   Padrao: data/mocks (modo mock) / data/inbox (modo real)
INBOX_DIR=

# OUT_DIR
#   Diretorio de saida: planilha, trilha de auditoria, fila de excecoes e painel.
#   Onde obter: Caminho no servidor (pasta com permissao de escrita para o usuario do servico).
#   Padrao: data/out
OUT_DIR=data/out

# DB_PATH
#   Arquivo SQLite do pipeline, fonte da verdade do dado (padrao: <OUT_DIR>/pipeline.db).
#   Onde obter: Caminho no servidor. Deixe vazio para usar <OUT_DIR>/pipeline.db.
#   Padrao: <OUT_DIR>/pipeline.db
DB_PATH=

# LOG_DIR
#   Diretorio dos arquivos de log de execucao (pipeline-AAAAMMDD.log).
#   Onde obter: Caminho no servidor, de preferencia coberto pela rotacao de logs.
#   Padrao: logs
LOG_DIR=logs

# LOG_LEVEL
#   Nivel de detalhe do log: DEBUG, INFO, WARNING, ERROR ou CRITICAL.
#   Onde obter: Digitado pelo operador. Use DEBUG para investigar uma coleta que falhou.
#   Padrao: INFO
LOG_LEVEL=INFO

# TELEGRAM_BOT_TOKEN  [obrigatoria em: real:telegram; SEGREDO - nunca versione o valor]
#   Token do bot do Telegram que recebe as mensagens dos pedidos (SEGREDO).
#   Onde obter: No Telegram, fale com @BotFather, crie/abra o bot e copie o token.
TELEGRAM_BOT_TOKEN=

# TELEGRAM_CHAT_ID  [obrigatoria em: real:telegram]
#   Identificador do chat ou grupo do Telegram que o bot deve ler (so os updates desse chat entram no pipeline).
#   Onde obter: Envie uma mensagem no grupo e leia getUpdates em https://api.telegram.org/bot<token>/getUpdates (campo message.chat.id).
TELEGRAM_CHAT_ID=

# TELEGRAM_API_BASE
#   Endereco base da API do Telegram. Só mude para apontar a um espelho/proxy local.
#   Onde obter: Valor fixo do Telegram: https://api.telegram.org
#   Padrao: https://api.telegram.org
TELEGRAM_API_BASE=https://api.telegram.org

# TELEGRAM_TIMEOUT_S
#   Tempo limite em segundos de cada chamada HTTP ao Telegram.
#   Onde obter: Digitado pelo operador (padrao 30).
#   Padrao: 30
TELEGRAM_TIMEOUT_S=30

# WHATSAPP_TOKEN  [obrigatoria em: real:whatsapp; SEGREDO - nunca versione o valor]
#   Token de acesso do app do WhatsApp Cloud API (SEGREDO).
#   Onde obter: No Meta for Developers: seu app > WhatsApp > API Setup > Access token.
WHATSAPP_TOKEN=

# WHATSAPP_PHONE_NUMBER_ID  [obrigatoria em: real:whatsapp]
#   Identificador do numero de WhatsApp Business que recebe as mensagens.
#   Onde obter: No Meta for Developers: seu app > WhatsApp > API Setup (campo Phone number ID).
WHATSAPP_PHONE_NUMBER_ID=

# WHATSAPP_VERIFY_TOKEN  [obrigatoria em: real:whatsapp; SEGREDO - nunca versione o valor]
#   Palavra-chave que o Meta usa para validar o webhook; e voce quem escolhe e repete no painel (SEGREDO).
#   Onde obter: Voce inventa uma palavra longa e cadastra a mesma no Meta for Developers > WhatsApp > Configuration > Webhook.
WHATSAPP_VERIFY_TOKEN=

# WHATSAPP_API_BASE
#   Endereco base da Graph API do WhatsApp. Só mude para apontar a um espelho/proxy local.
#   Onde obter: Valor do Meta for Developers (padrao https://graph.facebook.com/v21.0).
#   Padrao: https://graph.facebook.com/v21.0
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0

# WHATSAPP_WEBHOOK_DIR
#   Diretorio onde o receptor local do webhook grava os envelopes recebidos do WhatsApp.
#   Onde obter: Caminho no servidor, de preferencia fora da arvore versionada.
#   Padrao: data/inbox_webhook/whatsapp
WHATSAPP_WEBHOOK_DIR=data/inbox_webhook/whatsapp

